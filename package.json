{
  "name": "sachbazaar",
  "private": true,
  "packageManager": "pnpm@9.15.5",
  "workspaces": ["apps/*", "packages/*"],
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "contracts:compile": "npm run compile --workspace @sachbazaar/contracts",
    "contracts:test": "npm run test --workspace @sachbazaar/contracts",
    "contracts:coverage": "npm run coverage --workspace @sachbazaar/contracts",
    "contracts:slither": "npm run slither --workspace @sachbazaar/contracts"
  }
}
