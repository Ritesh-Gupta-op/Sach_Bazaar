# Shared
NODE_ENV=development
LOG_LEVEL=info

# Polygon / Hardhat
AMOY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/replace-me
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/replace-me
DEPLOYER_PRIVATE_KEY=replace-me
RELAYER_PRIVATE_KEY=replace-me
ORACLE_PRIVATE_KEY=replace-me
POLYGONSCAN_API_KEY=replace-me

# Backend
# NETWORK picks deployments/<network>.json (local | amoy); RPC_URL is the node the API reads/writes.
NETWORK=local
RPC_URL=http://127.0.0.1:8545
DATABASE_URL=postgresql://sachbazaar:sachbazaar@localhost:5432/sachbazaar?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
PII_ENCRYPTION_KEY=replace-with-32-byte-key-material
KEY_ENCRYPTION_KEY=replace-with-32-byte-key-material
AI_SERVICE_URL=http://localhost:8001
IPFS_API_URL=http://localhost:5001

# Storage / deployment
STORAGE_PROVIDER=local
PINATA_JWT=replace-me
API_PORT=3000

# Web demo/production wallet mode. Keep true only for the local Hardhat demo.
VITE_DEMO_MODE=true
VITE_RPC_URL=http://127.0.0.1:8545

# Required when VITE_DEMO_MODE=false. These are public addresses only; the
# corresponding accounts must be connected in the browser wallet.
VITE_ADMIN_ADDRESS=replace-with-admin-address
VITE_COOP_ADDRESS=replace-with-coop-address
VITE_BUYER_ADDRESS=replace-with-buyer-address
VITE_TRUCKER_ADDRESS=replace-with-trucker-address
VITE_COLD_STORAGE_ADDRESS=replace-with-cold-storage-address
VITE_MANDI_ADDRESS=replace-with-mandi-address
VITE_ORACLE_ADDRESS=replace-with-oracle-address
VITE_FARMER_PAYOUT_ADDRESS=replace-with-farmer-payout-address
VITE_COOP_PAYOUT_ADDRESS=replace-with-coop-payout-address
VITE_TRUCKER_PAYOUT_ADDRESS=replace-with-trucker-payout-address
VITE_COLD_STORAGE_PAYOUT_ADDRESS=replace-with-cold-storage-payout-address
VITE_MANDI_PAYOUT_ADDRESS=replace-with-mandi-payout-address
VITE_PLATFORM_PAYOUT_ADDRESS=replace-with-platform-payout-address

# Optional event indexer settings.
INDEXER_FROM_BLOCK=0
INDEXER_CONFIRMATIONS=1
INDEXER_POLL_MS=5000
INDEXER_CHUNK_SIZE=2000
DB_POOL_MAX=10
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_MS=60000
